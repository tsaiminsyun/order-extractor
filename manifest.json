{
  "manifest_version": 3,
  "name": "訂單擷取（Amazon.co.jp / 楽天）",
  "version": "0.13.1",
  "description": "擷取 Amazon.co.jp 與 楽天市場 的訂單內容，並匯出 JSON",
  "action": {
    "default_popup": "popup.html",
    "default_title": "訂單擷取（Amazon.co.jp / 楽天）"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.amazon.co.jp/*",
    "https://order.my.rakuten.co.jp/*",
    "https://chiikawamarket.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/gp/css/order-history*",
        "https://www.amazon.co.jp/your-orders/*",
        "https://www.amazon.co.jp/gp/your-account/order-history*",
        "https://order.my.rakuten.co.jp/purchase-history/*",
        "https://chiikawamarket.jp/account*"
      ],
      "js": [
        "src/content/util.js",
        "src/content/readers.js",
        "src/content/sites/amazon.js",
        "src/content/sites/rakuten.js",
        "src/content/sites/shopify.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
