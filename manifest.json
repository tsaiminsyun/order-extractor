{
  "manifest_version": 3,
  "name": "訂單擷取（Amazon / 楽天 / Shopify / タワーレコード / ポケモンセンター / にじさんじ / アニメイト / mu-mo）",
  "version": "0.27.0",
  "description": "從 Amazon.co.jp、楽天市場、Shopify 商店、タワーレコード、ポケモンセンターオンライン、にじさんじオフィシャルストア、アニメイト通販、mu-mo ショップ、ZOZOTOWN、plusmember 的訂單列表擷取配送中的訂單，匯出 JSON",
  "action": {
    "default_popup": "popup.html",
    "default_title": "訂單擷取（Amazon / 楽天 / Shopify / タワーレコード / ポケモンセンター / にじさんじ / アニメイト / mu-mo）"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.amazon.co.jp/*",
    "https://order.my.rakuten.co.jp/*",
    "https://chiikawamarket.jp/*",
    "https://tower.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/gp/css/order-history*",
        "https://www.amazon.co.jp/your-orders/*",
        "https://www.amazon.co.jp/gp/your-account/order-history*",
        "https://order.my.rakuten.co.jp/purchase-history/*",
        "https://chiikawamarket.jp/account*",
        "https://chiikawamarket.jp/*/account*",
        "https://tower.jp/ec/*"
      ],
      "js": [
        "src/content/util.js",
        "src/content/readers.js",
        "src/content/sites/amazon.js",
        "src/content/sites/rakuten.js",
        "src/content/sites/shopify.js",
        "src/content/sites/tower.js",
        "src/content/sites/pokemoncenter.js",
        "src/content/sites/nijisanji.js",
        "src/content/sites/animate.js",
        "src/content/sites/mumo.js",
        "src/content/sites/zozo.js",
        "src/content/sites/plusmember.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
